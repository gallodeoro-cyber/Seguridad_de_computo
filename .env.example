# Copia este archivo a .env para personalizar tu instalación local.
APP_ENV=development
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Déjala vacía SOLO en local: la app generará una clave temporal al arrancar.
SECRET_KEY=
# Vacío: se usará instance/users.sqlite3, fuera de static/.
DATABASE_PATH=
